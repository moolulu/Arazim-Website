---
import StationPage from "../layouts/Layout.astro";
import backgroundImg from "../assets/images/bush.jpg";

const pageDescription =
  "תוכנית ארזים היא תוכנית שמטרתה להכשיר את מיטב הצעירים בתחומי המתמטיקה והסייבר ולשבצם ביחידות המקצועיות והמסווגות ביותר.";

const baseUrl = import.meta.env.BASE_URL;
const cleanBaseUrl = baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl;

const stations = [
  {
    type: "hero",
    title: "תוכנית ארזים",
    text: "הופכים את הבלתי אפשרי לקשה מאוד",
  },
  {
    type: "standard",
    title: "מי אנחנו",
    text: "תוכנית ארזים היא תוכנית מצוינות של חיל המודיעין וחיל התקשוב, שנועדה לפתח מנהיגות מקצועית ביחידות נבחרות העוסקות בתחומי המתמטיקה והטכנולוגיה. לתוכנית מגויסים הצעירים המבטיחים ביותר בתחומים אלו, במטרה להכשירם לתפקידי הובלה ביחידות שאליהן הם מיועדים. במהלך ההכשרה, משלימים החניכים תואר ראשון דו-חוגי במתמטיקה ובמדעי המחשב באוניברסיטת תל אביב בהיקף מלא, תוך שנתיים בלבד. עם סיום התואר, משתבצים החניכים לשירות משמעותי ביחידה 8200 ובחטיבת ההגנה בסייבר. מדי שנה מתקבלים לתוכנית בין 10 ל-20 חניכים בלבד. היקפה המצומצם של התוכנית מאפשר לסגל להעניק לכל חניך ליווי אישי ומדוייק.",
    align: "center",
  },
  {
    type: "cards",
    mainTitle: "צירי ההכשרה",
    cards: [
      {
        icon: cleanBaseUrl + "/axes/academic.svg",
        title: "הציר האקדמי",
        description:
          "התוכנית דורשת מצוינות אקדמית כתנאי בסיס, ובאופן עקבי חניכי 'ארזים' זוכים באותות הצטיינות מטעם האוניברסיטה. מאחר שהחניכים משלימים את התואר בשנתיים בלבד, עליהם לעמוד בהיקף נרחב של קורסים ונדרשת מהם יכולת ניהול זמן עצמאית ומיטבית. התוכנית מעודדת את חניכיה להתעמק בחומר האקדמי מעבר לדרישות המסגרת, ואף להשתלב במחקר אקדמי במקביל ללימודים, עבור המתאימים לכך.",
      },
      {
        icon: cleanBaseUrl + "/axes/professional.svg",
        title: "הציר המקצועי",
        description:
          "במהלך לימודי התואר משלבת התוכנית הכשרה מקצועית, במטרה להכין את החניכים לשירותם הצבאי. על בסיס שבועי משתתפים החניכים בהרצאות ומתמודדים עם אתגרים מקצועיים, כך שבתום השנתיים הם צוברים ידע נרחב וכלים מעשיים לקראת השירות. בנוסף, בחודשי הקיץ נערכות סדנאות ממוקדות ואינטנסיביות, ועם סיום התואר וטרם הכניסה לתפקיד – משלימים החניכים קורסים והכשרות ייעודיות המותאמים לשיבוצם.",
      },
      {
        icon: cleanBaseUrl + "/axes/leadership.svg",
        title: "הציר המנהיגותי",
        description:
          "התוכנית מייעדת את חניכיה לתפקידי הובלה ומנהיגות, בין אם בפיקוד ישיר ביחידות שבהן הם משתבצים, ובין אם בהובלת שינויים טכנולוגיים כמוקדי ידע מנוסים. לאורך תקופת ההכשרה נחשפים החניכים לתכנים הממוקדים בפיתוח אישי ואישיותי, וצוברים התנסות מעשית במצבי פיקוד והנהגה. בנוסף, עם סיום התוכנית יוצאים הבוגרים לקורס קצינים, במטרה לרכוש כלים פיקודיים מתקדמים לקראת שירות משמעותי ומשפיע.",
      },
    ],
  },
  {
    type: "standard",
    title: "לימודים קודמים וארזים 2",
    text: "התוכנית פתוחה למועמדים שהחלו או השלימו את מרבית לימודי התואר הראשון שלהם במוסד אקדמי מוכר. למסיימי תואר ראשון מלא בתיכון או בדח\"ש מיועד מסלול \"ארזים 2\", בו משלימים החניכים תואר שני במדעי המחשב או במתמטיקה באוניברסיטת תל אביב בשנה אחת בלבד. במקביל ללימודיהם, הם משתלבים בהכשרה המקצועית של תוכנית \"ארזים\" ומשתבצים עם בוגריה ביחידות היעד. המיונים ל\"ארזים 2\" עבור חיל המודיעין ועבור חיל התקשוב מתקיימים בנפרד, וניתן להתמיין לשניהם במקביל.",
    align: "center",
  },
];
---

<StationPage
  description={pageDescription}
  backgroundImage={backgroundImg}
  stations={stations}
/>
